---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/paths';
---

<Base title="今日のことば · Japanese Word of the Day">
  <Header furigana />
  <main class="mx-auto flex w-full max-w-[960px] flex-col gap-6 px-5 pb-16 sm:gap-8 sm:px-12">
    <div class="flex flex-wrap items-center justify-between gap-2 text-[15px] text-muted">
      <span id="date-label" aria-live="polite">&nbsp;</span>
      <a href={url('archive')} class="font-semibold text-accent hover:underline">Archive ›</a>
    </div>

    <p id="status" class="hidden rounded-xl bg-accent-soft px-4 py-3 text-sm" role="status"></p>

    <section id="word" class="flex flex-col gap-4" aria-label="Word of the day">
      <div class="flex items-center gap-3">
        <h1 id="headword" lang="ja" class="headword font-serif-jp font-bold">
          &nbsp;
        </h1>
        <button
          type="button"
          id="speak-word"
          aria-label="Hear the word"
          class="inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-line bg-surface text-accent"
        >
        </button>
      </div>
      <p id="reading" lang="ja" class="font-jp text-[28px] font-medium text-accent sm:text-[36px]"></p>
      <div id="chips" class="flex flex-wrap gap-2"></div>
    </section>

    <section id="meaning-card" class="flex flex-col gap-4 rounded-2xl border border-line bg-surface p-5 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold">Meaning</h2>
        <div
          id="def-toggle"
          class="inline-flex gap-1 rounded-full border border-line bg-chip p-1"
          role="group"
          aria-label="Definition language"
        >
        </div>
      </div>
      <p id="meaning-text" class="text-lg leading-relaxed sm:text-xl"></p>
      <p id="glosses" class="text-sm text-muted"></p>
    </section>

    <section id="examples-card" class="flex flex-col gap-4 rounded-2xl border border-line bg-surface p-5 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold">Example sentences</h2>
        <div
          id="tier-toggle"
          class="flex w-full gap-1 rounded-full border border-line bg-chip p-1 sm:inline-flex sm:w-auto"
          role="group"
          aria-label="Difficulty"
        >
        </div>
      </div>
      <p id="tier-caption" class="text-sm text-muted"></p>
      <ul id="sentences" class="flex flex-col gap-5"></ul>
      <p id="sentences-note" class="text-xs text-muted"></p>
    </section>

    <Footer />
  </main>
</Base>

<script>
  import '../scripts/word-page';
</script>
